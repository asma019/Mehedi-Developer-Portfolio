# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
# The canonical domain of the deployed site. Everything (SEO meta,
# sitemap, robots.txt, llms.txt, structured data) is generated from
# this — change it and rebuild to run on any domain.
VITE_SITE_URL=https://mehedims.com

# ── Contact form email (SMTP) ────────────────────────────────
# Used on Vercel, Netlify, Render and Heroku.
# Gmail example:  HOST=smtp.gmail.com  PORT=587  SECURE=false
# (enable an App Password: https://myaccount.google.com/apppasswords)
# Zoho example:   HOST=smtp.zoho.com  PORT=465  SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
MAIL_FROM="Portfolio Contact <you@example.com>"
MAIL_TO=hello@mehedims.com

# ── Cloudflare Workers (Email Sending Worker binding) ───────
# The EMAIL binding in wrangler.toml handles auth automatically —
# no API token is required. Only set these if you want to override
# the defaults baked into the worker code.
#
# MAIL_FROM must be a verified domain in your Cloudflare account
# (e.g. welcome@mehedims.com).
# MAIL_FROM=
# MAIL_TO=

# ── Cloudflare Workers (REST API alternative) ────────────────
# If you prefer the REST API over the Worker binding, set these
# and use send-via-cf-rest.mjs instead of the EMAIL binding.
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# with the "Email Sending: Edit" permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ── Cloudflare Workers (Resend fallback) ─────────────────────
# Legacy: uses the Resend HTTP API. Only needed if you revert the
# worker to send-resend.mjs. https://resend.com (free tier)
# RESEND_API_KEY=

# ── Node server (Render / Heroku / local production test) ────
PORT=3000